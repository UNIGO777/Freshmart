{
  "info": {
    "name": "Khetan Mart Backend API",
    "description": "Complete API reference for all Khetan Mart microservices. All requests go through the API Gateway at {{baseUrl}}. Protected routes require Authorization: Bearer {{accessToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "baseUrl",     "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "",                      "type": "string" },
    { "key": "orderId",     "value": "",                      "type": "string" },
    { "key": "jobId",       "value": "",                      "type": "string" },
    { "key": "vendorId",    "value": "",                      "type": "string" },
    { "key": "productId",   "value": "",                      "type": "string" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/send-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919876543210\"\n}" }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/verify-otp",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"+919876543210\",\n  \"otp\": \"123456\",\n  \"role\": \"customer\"\n}" }
          }
        },
        {
          "name": "Register (Email)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/register-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Secret123!\",\n  \"role\": \"customer\"\n}" }
          }
        },
        {
          "name": "Login (Email)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/login-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"Secret123!\",\n  \"role\": \"customer\"\n}" }
          }
        },
        {
          "name": "Google OAuth",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/google",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"idToken\": \"<google-id-token>\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh-token>\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/auth/logout",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"<refresh-token>\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?lang=hi",
              "host": ["{{baseUrl}}"], "path": ["api","products"],
              "query": [
                { "key": "lang",     "value": "hi",          "description": "hi or en" },
                { "key": "category", "value": "fruits",      "description": "fruits | vegetables | spices", "disabled": true },
                { "key": "search",   "value": "apple",       "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/categories?lang=hi" }
        },
        {
          "name": "Get Product by ID",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
        },
        {
          "name": "[Admin] Create Product",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/products",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Apple\",\n  \"nameHi\": \"सेब\",\n  \"category\": \"fruits\",\n  \"unit\": \"kg\",\n  \"buyingPrice\": 80,\n  \"sellingPrice\": 120\n}" }
          }
        },
        {
          "name": "[Admin] Update Product",
          "request": {
            "method": "PUT", "url": "{{baseUrl}}/api/products/{{productId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"sellingPrice\": 130,\n  \"buyingPrice\": 85\n}" }
          }
        },
        {
          "name": "[Admin] Toggle Availability",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/products/{{productId}}/toggle",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "[Admin] Bulk Update Prices",
          "request": {
            "method": "PUT", "url": "{{baseUrl}}/api/products/bulk-prices",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"updates\": [\n    { \"id\": \"<productId1>\", \"buyingPrice\": 80, \"sellingPrice\": 120 },\n    { \"id\": \"<productId2>\", \"buyingPrice\": 50, \"sellingPrice\": 80 }\n  ]\n}" }
          }
        }
      ]
    },

    {
      "name": "Orders",
      "item": [
        {
          "name": "Check Stock (Pre-payment)",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/orders/check-stock",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 2 }],\n  \"deliveryAddress\": { \"lat\": 28.6139, \"lng\": 77.2090, \"fullAddress\": \"New Delhi\" }\n}" }
          }
        },
        {
          "name": "Validate Coupon",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/orders/validate-coupon",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"FRESH50\",\n  \"orderSubtotal\": 500\n}" }
          }
        },
        {
          "name": "Place Order",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/orders",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [{ \"productId\": \"{{productId}}\", \"quantity\": 2 }],\n  \"deliveryAddress\": { \"lat\": 28.6139, \"lng\": 77.2090, \"fullAddress\": \"New Delhi\" },\n  \"paymentMethod\": \"cod\",\n  \"couponCode\": \"FRESH50\"\n}" }
          }
        },
        {
          "name": "Get Order History",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/orders?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["api","orders"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Get Order Detail",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/orders/{{orderId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Changed my mind\"\n}" }
          }
        },
        {
          "name": "Rate Order",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/orders/{{orderId}}/rate",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"product\": 5,\n  \"rider\": 4,\n  \"comment\": \"Fresh produce, quick delivery!\"\n}" }
          }
        },
        {
          "name": "[Vendor] Get Incoming Orders",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/orders/vendor/incoming",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "[Vendor] Accept Order",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/orders/vendor/{{orderId}}/accept",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"acceptedItems\": [{ \"productId\": \"{{productId}}\", \"quantity\": 2 }]\n}" }
          }
        },
        {
          "name": "[Vendor] Reject Order",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/orders/vendor/{{orderId}}/reject",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Vendor (Inventory & Earnings)",
      "item": [
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/vendors/inventory",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Upsert Inventory",
          "request": {
            "method": "PUT", "url": "{{baseUrl}}/api/vendors/inventory/{{productId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantityAvailable\": 50,\n  \"isAvailable\": true\n}" }
          }
        },
        {
          "name": "Toggle Inventory Availability",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/vendors/inventory/{{productId}}/toggle",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Bulk Update Inventory",
          "request": {
            "method": "PUT", "url": "{{baseUrl}}/api/vendors/inventory/bulk",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"items\": [\n    { \"productId\": \"<id1>\", \"quantityAvailable\": 30 },\n    { \"productId\": \"<id2>\", \"quantityAvailable\": 0, \"isAvailable\": false }\n  ]\n}" }
          }
        },
        {
          "name": "Get Earnings",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/vendors/earnings?period=week", "host": ["{{baseUrl}}"], "path": ["api","vendors","earnings"], "query": [{ "key": "period", "value": "week", "description": "today | week | all" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Delivery (Rider)",
      "item": [
        {
          "name": "Toggle Online Status",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/delivery/rider/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"isOnline\": true\n}" }
          }
        },
        {
          "name": "Get My Jobs",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/delivery/rider/orders",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Accept Job",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/delivery/rider/accept/{{jobId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Reject Job",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/delivery/rider/reject/{{jobId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Mark Picked Up",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/delivery/rider/pickup/{{jobId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Mark Delivered",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/delivery/rider/deliver/{{jobId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Update Location",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/delivery/rider/location",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"lat\": 28.6139,\n  \"lng\": 77.2090\n}" }
          }
        },
        {
          "name": "Get Earnings",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/delivery/rider/earnings",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Payments",
      "item": [
        {
          "name": "Initiate UPI Payment",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/payments/create-order",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 25000\n}" }
          }
        },
        {
          "name": "Check Payment Status",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/payments/status/<merchantTransactionId>",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Confirm COD Order",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/payments/cod-confirm",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"orderId\": \"{{orderId}}\"\n}" }
          }
        },
        {
          "name": "[Admin] Refund",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/payments/refund/<transactionId>",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Update FCM Token",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/notifications/fcm-token",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"<fcm-device-token>\"\n}" }
          }
        },
        {
          "name": "[Admin] Send Promo Push",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/notifications/promo",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Weekend Offer 🎉\",\n  \"body\": \"Get 20% off on all vegetables this weekend!\",\n  \"target\": \"customers\",\n  \"screen\": \"Offers\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/dashboard",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/analytics?period=week", "host": ["{{baseUrl}}"], "path": ["api","admin","analytics"], "query": [{ "key": "period", "value": "week", "description": "day | week | month | year" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Pricing Overview",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/pricing",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "List Vendors",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/vendors?approved=false", "host": ["{{baseUrl}}"], "path": ["api","admin","vendors"], "query": [{ "key": "approved", "value": "false" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Approve Vendor",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/admin/vendors/{{vendorId}}/approve",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Block Vendor",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/admin/vendors/{{vendorId}}/block",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "List Riders",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/riders",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "List Customers",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/customers",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/orders?status=confirmed&page=1", "host": ["{{baseUrl}}"], "path": ["api","admin","orders"], "query": [{ "key": "status", "value": "confirmed" }, { "key": "page", "value": "1" }] },
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Override Order Status",
          "request": {
            "method": "PATCH", "url": "{{baseUrl}}/api/admin/orders/{{orderId}}/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"cancelled\",\n  \"reason\": \"Admin override — item not available\"\n}" }
          }
        },
        {
          "name": "List Payouts",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/payouts",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Trigger Vendor Payout",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/admin/payouts/{{vendorId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Create Coupon",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/api/admin/coupons",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"FRESH50\",\n  \"discountType\": \"flat\",\n  \"discountValue\": 50,\n  \"minOrderValue\": 300,\n  \"maxUses\": 1000,\n  \"validFrom\": \"2026-05-01T00:00:00Z\",\n  \"validTo\": \"2026-05-31T23:59:59Z\"\n}" }
          }
        },
        {
          "name": "List Coupons",
          "request": {
            "method": "GET", "url": "{{baseUrl}}/api/admin/coupons",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        },
        {
          "name": "Disable Coupon",
          "request": {
            "method": "DELETE", "url": "{{baseUrl}}/api/admin/coupons/<couponId>",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }]
          }
        }
      ]
    }

  ]
}
